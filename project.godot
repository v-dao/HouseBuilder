; 房屋建筑软件 — 国标建筑施工图设计与施工过程模拟
; Godot 项目配置文件（Godot 4.7）

config_version=5

[application]

config/name="房屋建筑软件"
config/description="国标建筑施工图设计 / 施工过程模拟 / 工程量统计"
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[internationalization]

locale/test="zh_CN"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_2d=2
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
limits/buffers/canvas_polygon_buffer_size_kb=4096
limits/buffers/canvas_polygon_index_buffer_size_kb=16384
